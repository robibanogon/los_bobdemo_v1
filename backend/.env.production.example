# Production Environment Configuration
# Copy this file to .env.production and fill in the actual values
# DO NOT commit .env.production to version control

# Application
NODE_ENV=production
PORT=3001

# Database Configuration (RDS)
# These should be retrieved from AWS Secrets Manager in production
DB_HOST=los-db.xxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=los_production
DB_USER=los_admin
DB_PASSWORD=<retrieve-from-secrets-manager>

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=<your-aws-account-id>

# S3 Configuration
S3_BUCKET_NAME=los-documents-production
S3_REGION=us-east-1

# Authentication
JWT_SECRET=<retrieve-from-secrets-manager>
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=https://los.example.com

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
ENABLE_DOCUMENT_UPLOAD=true
ENABLE_CREDIT_ANALYSIS=true
ENABLE_AGENT_REVIEW=true
ENABLE_DECISION_WORKFLOW=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# Session Configuration
SESSION_SECRET=<retrieve-from-secrets-manager>
SESSION_MAX_AGE=86400000

# Email Configuration (if using SES)
EMAIL_FROM=noreply@los.example.com
EMAIL_REGION=us-east-1

# Monitoring and Observability
ENABLE_METRICS=true
ENABLE_TRACING=true
METRICS_PORT=9090

# Security Headers
HELMET_ENABLED=true
HSTS_MAX_AGE=31536000

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# CloudWatch Logs
CLOUDWATCH_LOG_GROUP=/ecs/los-backend
CLOUDWATCH_LOG_STREAM=backend

# Health Check
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30000

# Graceful Shutdown
SHUTDOWN_TIMEOUT=30000

# External Services
# Add any external service URLs or API keys here
# EXTERNAL_API_URL=https://api.external-service.com
# EXTERNAL_API_KEY=<retrieve-from-secrets-manager>