# Production Environment Configuration
# Copy this file to .env.production and fill in the actual values
# DO NOT commit .env.production to version control

# API Configuration
VITE_API_URL=https://api.los.example.com
VITE_API_VERSION=v1

# Application Configuration
VITE_APP_NAME=Loan Origination System
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=production

# CloudFront/CDN Configuration
VITE_CDN_URL=https://d1234567890.cloudfront.net

# Feature Flags
VITE_ENABLE_DOCUMENT_UPLOAD=true
VITE_ENABLE_CREDIT_ANALYSIS=true
VITE_ENABLE_AGENT_REVIEW=true
VITE_ENABLE_DECISION_WORKFLOW=true
VITE_ENABLE_AUDIT_LOG=true

# Authentication
VITE_JWT_STORAGE_KEY=los_auth_token
VITE_SESSION_TIMEOUT=1440000

# File Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png

# UI Configuration
VITE_THEME=light
VITE_LANGUAGE=en
VITE_DATE_FORMAT=MM/DD/YYYY
VITE_CURRENCY=USD

# Pagination
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100

# Analytics (if using)
# VITE_ANALYTICS_ID=UA-XXXXXXXXX-X
# VITE_GTM_ID=GTM-XXXXXXX

# Error Tracking (if using Sentry, etc.)
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
# VITE_SENTRY_ENVIRONMENT=production

# Performance Monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Debug Mode (should be false in production)
VITE_DEBUG_MODE=false
VITE_SHOW_DEV_TOOLS=false

# API Timeouts (in milliseconds)
VITE_API_TIMEOUT=30000
VITE_UPLOAD_TIMEOUT=120000

# Refresh Intervals (in milliseconds)
VITE_DATA_REFRESH_INTERVAL=60000
VITE_STATUS_CHECK_INTERVAL=30000

# Contact Information
VITE_SUPPORT_EMAIL=support@los.example.com
VITE_SUPPORT_PHONE=1-800-XXX-XXXX

# Legal Links
VITE_PRIVACY_POLICY_URL=https://los.example.com/privacy
VITE_TERMS_OF_SERVICE_URL=https://los.example.com/terms

# Social Media (if applicable)
# VITE_TWITTER_URL=https://twitter.com/yourcompany
# VITE_LINKEDIN_URL=https://linkedin.com/company/yourcompany